# ============================================
# ESPORT NEWS - Environment Variables (CENTRALISÉ)
# ============================================
# ⚠️ IMPORTANT: Copier ce fichier vers .env et remplir avec vos vraies valeurs
# ⚠️ NE JAMAIS committer les fichiers .env* dans Git
#
# Ce fichier est la SOURCE UNIQUE pour toutes les variables d'environnement.
# Le backend Go, le frontend Next.js et l'app mobile chargent tous ce fichier
# depuis la racine du projet (via ../.env depuis leur sous-dossier).

# ===================
# Server / Backend Go
# ===================
PORT=4000
ENV=development
ENVIRONMENT=development
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
LOG_LEVEL=debug

# ===================
# Database (PostgreSQL)
# ===================
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_64_CHARS
DB_NAME=esportnews
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_64_CHARS
POSTGRES_DB=esportnews
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD_64_CHARS@postgres:5432/esportnews?sslmode=disable

# ===================
# Redis
# ===================
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_64_CHARS
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD_64_CHARS@redis:6379/0

# ===================
# JWT
# ===================
JWT_SECRET=CHANGE_ME_STRONG_SECRET_128_CHARS

# ===================
# Frontend (Next.js) - URLs LOCALES
# ===================
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Domaine propre devant le bucket R2 (ex: images.esportnews.fr). Vide = URLs r2.dev telles que stockées.
NEXT_PUBLIC_IMAGE_HOST=
NEXTAUTH_SECRET=CHANGE_ME_STRONG_SECRET_128_CHARS
NEXTAUTH_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3002,http://localhost:3000,http://localhost:4000

# ===================
# Supabase (legacy)
# ===================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===================
# APIs Externes
# ===================
# PANDASCORE_API_KEY and SPORTDEVS_API_KEY removed (replaced by LIQUIPEDIA_API_KEY)

# ===================
# Stripe
# ===================
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY_LIVE=sk_live_your_stripe_live_secret_key
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PRICE_ID=price_your_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ===================
# Email (Resend)
# ===================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# ===================
# Cloudflare
# ===================
CLOUDFLARE_TOKEN=your_cloudflare_token

# ===================
# Cloudflare R2 Storage
# ===================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ===================
# Upload Configuration
# ===================
MAX_UPLOAD_SIZE=524288000
UPLOAD_TIMEOUT=600

# ===================
# Performance
# ===================
CACHE_TTL=3600
DB_MAX_CONNECTIONS=50

# ===================
# Liquipedia
# ===================
LIQUIPEDIA_API_KEY=your_liquipedia_api_key_here
# Per-wiki hourly request ceiling (default 1000). Lower to stay safely below
# Liquipedia's published quota; raise only if quota is officially extended.
LIQUIPEDIA_BUDGET_PER_WIKI=1000
# Set to true once the LiquipediaDB dashboard is configured to POST to
# /api/webhooks/liquipedia. When enabled, the poller refreshes on demand
# instead of polling every wiki on a fixed cadence.
LIQUIPEDIA_WEBHOOKS_ENABLED=false
# Shared secret sent by LiquipediaDB in the X-Webhook-Secret header.
# Generate with: openssl rand -hex 32. Leave empty to disable the check
# (development only — never in production).
LIQUIPEDIA_WEBHOOK_SECRET=

# ===================
# Background services
# ===================
# Match notification scheduler — true in prod, false on preview/staging that
# share the prod database (prevents duplicate push notifications and races on
# the match_subscriptions table).
NOTIFICATION_SCHEDULER_ENABLED=true

# ===================
# IAP (In-App Purchase) — Apple & Google
# ===================
APPLE_IAP_KEY_PATH=./keys/AuthKey_XXXXXXXX.p8
APPLE_IAP_KEY_ID=XXXXXXXX
APPLE_IAP_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_IAP_BUNDLE_ID=com.esportnews-app.mobile

GOOGLE_IAP_KEY_PATH=./keys/google-service-account.json
# Railway ne monte aucun fichier : y fournir le JSON du compte de service sur une ligne
GOOGLE_IAP_KEY_CONTENT=
GOOGLE_IAP_PACKAGE=com.esportnewsapp.mobile

# ===================
# Mobile App (Expo)
# ===================
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_API_URL=http://localhost:4000

# ===================
# AdMob
# ===================
ADMOB_IOS_APP_ID=ca-app-pub-xxxxx~xxxxx
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxx~xxxxx
ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxx/xxxxx

# ===================
# IAP - In-App Purchase (iOS App Store + Google Play)
# ===================
# Apple App Store Server API (.p8 key from App Store Connect)
APPLE_IAP_KEY_PATH=./keys/AuthKey_XXXXXXXX.p8
APPLE_IAP_KEY_ID=XXXXXXXX
APPLE_IAP_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_IAP_BUNDLE_ID=com.esportnews-app.mobile

# Google Play Developer API (Service Account JSON)
GOOGLE_IAP_KEY_PATH=./keys/google-service-account.json
# Railway ne monte aucun fichier : y fournir le JSON du compte de service sur une ligne
GOOGLE_IAP_KEY_CONTENT=
GOOGLE_IAP_PACKAGE=com.esportnewsapp.mobile

# ============================================================================
# Back-office (admin.esportnews.fr) — voir CLAUDE.md §23
# ============================================================================
# Origine de l'application du back-office : CORS et liens des e-mails.
BACKOFFICE_URL=http://localhost:3100
# Clé de chiffrement des secrets de double authentification. Vide = dérivée de
# JWT_SECRET. La changer invalide tous les secrets déjà enregistrés.
BACKOFFICE_SECRET=
SITE_URL=https://www.esportnews.fr
# Bouton « Continuer avec Google » de la connexion (masqué si vide).
GOOGLE_OAUTH_CLIENT_ID=

# Sources externes : chacune est facultative, une carte sans identifiants
# affiche « non connecté » et aucun chiffre.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Propriété Search Console (ex. sc-domain:esportnews.fr) et clé JSON, sur une
# ligne, d'un compte de service ajouté comme utilisateur de cette propriété.
GSC_SITE_URL=
GSC_CREDENTIALS_JSON=
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
UPSTASH_EMAIL=
UPSTASH_API_KEY=
UPSTASH_DATABASE_ID=
# Clé d'équipe App Store Connect avec accès aux ventes (pas la clé d'achats intégrés).
APPSTORE_CONNECT_KEY_ID=
APPSTORE_CONNECT_ISSUER_ID=
APPSTORE_CONNECT_KEY_CONTENT=
APPSTORE_CONNECT_VENDOR_ID=
APPSTORE_CONNECT_APP_SKU=
# Bucket des rapports de la Play Console (gs://pubsite_prod_rev_…).
PLAY_REPORTS_BUCKET=
PLAY_REPORTS_CREDENTIALS_JSON=

# Local seulement : détourne les appels à Expo (push) vers une adresse locale.
# EXPO_PUSH_BASE_URL=http://127.0.0.1:4193
